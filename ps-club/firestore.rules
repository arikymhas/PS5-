rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Вспомогательные функции
    function signedIn() { 
      return request.auth != null; 
    }
    
    // Безопасная проверка прав администратора
    function isAdmin() { 
      return signedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }

    // Пользователи
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Игровые зоны
    match /zones/{zoneId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // История бронирований
    match /bookings/{bookingId} {
      // ПРИМЕЧАНИЕ: allow list требует отправки правильного query с фильтрацией по userId!
      allow read: if signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Активные брони
    match /activeBookings/{bookingId} {
      allow read: if signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Отзывы
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}2